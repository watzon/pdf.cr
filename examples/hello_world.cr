require "../src/pdf"

# Create a simple PDF document
pdf = PDF::Document.new
pdf.title = "Hello World Example"
pdf.author = "pdf.cr"

pdf.page do |page|
  # Title
  page.font "Helvetica-Bold", size: 24
  page.text "Hello, World!", at: {72, 720}
  
  # Subtitle
  page.font "Helvetica", size: 14
  page.text "Generated by pdf.cr - A Pure Crystal PDF Library", at: {72, 690}
  
  # Body text
  page.font "Times-Roman", size: 12
  page.text "This PDF was generated entirely in Crystal without any C dependencies.", at: {72, 650}
  page.text "The library supports:", at: {72, 620}
  page.text "- Standard Type1 fonts (Helvetica, Times, Courier)", at: {90, 600}
  page.text "- Basic text positioning", at: {90, 580}
  page.text "- Vector graphics (lines, rectangles)", at: {90, 560}
  page.text "- Multiple pages", at: {90, 540}
  page.text "- FlateDecode compression", at: {90, 520}
  
  # Draw a decorative line
  page.stroke_color 0.2, 0.4, 0.8
  page.line_width 2
  page.move_to 72, 480
  page.line_to 540, 480
  page.stroke
  
  # Draw a colored rectangle
  page.fill_color 0.9, 0.95, 1.0
  page.stroke_color 0.2, 0.4, 0.8
  page.line_width 1
  page.rectangle 72, 380, 468, 80
  page.fill_stroke
  
  # Text inside the rectangle
  page.font "Courier", size: 10
  page.text "pdf = PDF::Document.new", at: {82, 430}
  page.text "pdf.page { |page| page.text \"Hello!\", at: {72, 720} }", at: {82, 410}
  page.text "pdf.save(\"output.pdf\")", at: {82, 390}
end

# Add a second page
pdf.page do |page|
  page.font "Helvetica-Bold", size: 18
  page.text "Page 2", at: {72, 720}
  
  page.font "Helvetica", size: 12
  page.text "This is the second page of the document.", at: {72, 690}
end

pdf.save("examples/hello_world.pdf")
puts "Generated examples/hello_world.pdf"
